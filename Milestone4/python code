import time  # Import the time module for delay
import numpy as np
def sysCall_init():
    sim = require('sim')
    
    # Get the handles for each joint
    self.objectiveHandle_1 = sim.getObject("../q1")
    self.objectiveHandle_2 = sim.getObject("../q2")
    self.objectiveHandle_3= sim.getObject("../q3")
    self.objectiveHandle_4 = sim.getObject("../q4")
   # self.target_position = -90 *(3.14/180)
    self.required_duration = 0.1
    self.u = 0

def sysCall_actuation():
   
    
   # for u in np.arange(0, 5 , 0.1):  # 5.1 ensures 5 is included
    
    # Define your desired joint positions based on `pos`
    self.u += 0.1 
    if self.u <= 5:
        
        curr_time = sim.getSimulationTime()
        self.target_position_1 = 10.8*self.u**2 - 1.44*self.u**3
        self.target_position_1 = self.target_position_1 * (3.14 / 180)
        self.target_position_2= -1*self.target_position_1 
        if curr_time < self.required_duration:
            new_position1 = (curr_time/self.required_duration)*self.target_position_1
            sim.setJointTargetPosition(self.objectiveHandle_1, new_position1)
        else:
            sim.setJointTargetPosition(self.objectiveHandle_1, self.target_position_1)

        # Set each joint to the new position
        if curr_time < self.required_duration:
            new_position2 = (curr_time/self.required_duration)*self.target_position_2
            sim.setJointTargetPosition(self.objectiveHandle_2, new_position2)
        else:
            sim.setJointTargetPosition(self.objectiveHandle_2, self.target_position_2)

    if self.u >= 5 and self.u <= 10:
        i = self.u-5
        curr_time = sim.getSimulationTime()
        self.target_position_1 = 90-10.8*i**2 + 1.44*i**3
        self.target_position_1 = self.target_position_1 * (3.14 / 180)
        self.target_position_2= 90-6.48*i**2+0.864*i**3
        self.target_position_2 = self.target_position_2 * (-3.14 / 180)
        self.target_position_3= 5.76*i**2-0.768*i**3
        self.target_position_3 = self.target_position_3 * (3.14 / 180)
        if curr_time < self.required_duration:
            new_position1 = (curr_time/self.required_duration)*self.target_position_1
            sim.setJointTargetPosition(self.objectiveHandle_1, new_position1)
        else:
            sim.setJointTargetPosition(self.objectiveHandle_1, self.target_position_1)

        # Set each joint to the new position
        if curr_time < self.required_duration:
            new_position2 = (curr_time/self.required_duration)*self.target_position_2
            sim.setJointTargetPosition(self.objectiveHandle_2, new_position2)
        else:
            sim.setJointTargetPosition(self.objectiveHandle_2, self.target_position_2)

        if curr_time < self.required_duration:
            new_position3 = (curr_time/self.required_duration)*self.target_position_3
            sim.setJointTargetPosition(self.objectiveHandle_3, new_position3)
        else:
            sim.setJointTargetPosition(self.objectiveHandle_3, self.target_position_3)
            

    

